# 复制为 server/.env 后按需修改。密钥类配置不要提交。

# ---------- Ollama（本地推理后端） ----------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=5m

# ---------- 向量化 / 重排（fastembed，本地 ONNX，无需 PyTorch） ----------
# 向量化：Qwen3-Embedding-0.6B-Q（int8，1024 维，中文强，约 1.1GB）
# fastembed 不支持 bge-m3，别改
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B-Q
VECTOR_DIM=1024
# 查询指令前缀，Qwen3-Embedding 官方要求查询带指令、文档不带。留空则不加
EMBED_QUERY_INSTRUCTION=Given a question, retrieve relevant passages from a knowledge base that answer the question
# 重排：bge-reranker-v2-m3 的 int8 版（约 0.57GB，fp16 版要 2.27GB 装不下）
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_ENABLED=true

# ---------- 检索 ----------
RETRIEVE_TOP_N=50
RRF_K=60
RERANK_TOP_K=5
CONTEXT_CHUNK_CHARS=800

# ---------- 分块 ----------
CHUNK_TARGET_CHARS=500
CHUNK_OVERLAP_CHARS=80

# ---------- 其它 ----------
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
# HuggingFace 模型下载镜像。直连 huggingface.co 会超时，fastembed 拉权重必须走镜像
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录。fastembed 默认放系统临时目录，macOS 重启后会清掉，1.7GB 白下
FASTEMBED_CACHE_PATH=~/.cache/fastembed
